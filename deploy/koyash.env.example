# Copy to deploy/koyash.env on the server and replace every placeholder.
# Keep passwords URL-safe because MONGO_ROOT_PASSWORD is embedded in MONGO_URI.
MONGO_ROOT_USERNAME=koyash
MONGO_ROOT_PASSWORD=replace_with_url_safe_random_value
MONGO_DB_NAME=koyash

JWT_SECRET_KEY=replace_with_random_value_of_at_least_32_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
ANALYTICS_RAW_EVENT_TTL_DAYS=180

KOYASH_HTTP_PORT=8080
FRONTEND_BASE_URL=http://10.93.26.208:8080

LLM_ENABLED=true
LLM_PROVIDER=vsellm
LLM_TIMEOUT_SECONDS=12
VSELLM_BASE_URL=https://api.vsellm.ru/v1
VSELLM_MODEL=openai/gpt-4o-mini
VSELLM_API_KEY=replace_with_vsellm_key

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
SMTP_ENABLED=false
