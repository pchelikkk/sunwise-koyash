APP_NAME=KOYASH API
APP_ENV=development
API_V1_PREFIX=/api/v1

MONGO_URI=mongodb://koyash:koyash_dev_password@mongo:27017/?authSource=admin
MONGO_DB_NAME=koyash

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Development placeholder. Production startup requires a unique 32+ byte secret.
JWT_SECRET_KEY=koyash_development_only_change_before_prod_2026
ACCESS_TOKEN_EXPIRE_MINUTES=60

ANALYTICS_RAW_EVENT_TTL_DAYS=180

# Canonical catalog mounted by docker-compose. Import is validated and idempotent.
IMPORT_DATASET_ON_STARTUP=true
PRODUCT_DATASET_PATH=/data/products.xlsx

# Optional runtime explanation rewrite. Selection and safety stay deterministic.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_TIMEOUT_SECONDS=12
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Optional OpenAI-compatible VseLLM alternative.
VSELLM_BASE_URL=https://api.vsellm.ru/v1
VSELLM_MODEL=openai/gpt-4o-mini
VSELLM_API_KEY=


FRONTEND_BASE_URL=http://localhost:8080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@koyash.local
SMTP_FROM_NAME=KOYASH
