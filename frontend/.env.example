# Base URL of the KOYASH API.
# In the Docker/nginx deployment the SPA is served same-origin and nginx
# reverse-proxies /api to the backend, so the default works without CORS.
VITE_API_BASE_URL=/api/v1

# For local `npm run dev` against a backend on localhost:8000 use instead:
# VITE_API_BASE_URL=http://localhost:8000/api/v1